# Used by api/contact.js (Vercel serverless function).
# Locally: copy this file to .env and run `vercel dev` to test the function.
# In production: set these same keys in Vercel → Project → Settings →
# Environment Variables (not in a committed .env file).
CONTACT_RECEIVER=

# SMTP credentials for Nodemailer. Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=<16-character Gmail App Password, not your normal password>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
